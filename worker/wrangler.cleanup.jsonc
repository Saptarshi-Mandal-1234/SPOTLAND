{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "spotland-expiry-cleanup",
  "main": "src/cleanup-worker.ts",
  "compatibility_date": "2026-09-30",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["*/5 * * * *"] },
  "d1_databases": [{ "binding": "DB", "database_name": "travelapp", "database_id": "345c1b77-e110-4e37-9c88-51810db8495c", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "REVIEW_PHOTOS", "bucket_name": "spotland-review-photos" }]
}
